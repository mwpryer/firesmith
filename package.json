{
  "name": "firesmith",
  "version": "2.0.1",
  "description": "Thin typed wrapper over both Firestore SDKs",
  "license": "MIT",
  "author": "mwpryer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwpryer/firesmith.git"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "firebase emulators:exec --only firestore --project firesmith 'bun test'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "format": "bun run lint:fix && bun run fmt",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "firebase": "^11.0.0 || ^12.0.0",
    "firebase-admin": "^12.0.0 || ^13.0.0 || ^14.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    }
  }
}
